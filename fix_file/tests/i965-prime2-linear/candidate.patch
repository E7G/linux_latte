+/*
+ * The legacy GEM import can represent a single linear YUV420 object.
+ * Translate only descriptors whose offsets/strides it preserves exactly.
+ */
+static VAStatus
+i965_prime2_to_external(const VADRMPRIMESurfaceDescriptor *desc,
+			unsigned int width, unsigned int height,
+			VASurfaceAttribExternalBuffers *external, uintptr_t *fd)
+{
+	uint32_t drm_format, planes;
+
+	if (!desc || desc->width != width || desc->height != height ||
+	    (width | height) & 1)
+		return VA_STATUS_ERROR_INVALID_PARAMETER;
+
+	switch (desc->fourcc) {
+	case VA_FOURCC_NV12:
+		drm_format = DRM_FORMAT_NV12;
+		planes = 2;
+		break;
+	case VA_FOURCC_I420:
+		drm_format = DRM_FORMAT_YUV420;
+		planes = 3;
+		break;
+	case VA_FOURCC_YV12:
+		drm_format = DRM_FORMAT_YVU420;
+		planes = 3;
+		break;
+	default:
+		return VA_STATUS_ERROR_UNSUPPORTED_MEMORY_TYPE;
+	}
+
+	if (desc->num_objects != 1 || desc->num_layers != 1 ||
+	    desc->objects[0].drm_format_modifier != DRM_FORMAT_MOD_LINEAR ||
+	    desc->layers[0].drm_format != drm_format ||
+	    desc->layers[0].num_planes != planes)
+		return VA_STATUS_ERROR_UNSUPPORTED_MEMORY_TYPE;
+
+	const uint32_t *pitch = desc->layers[0].pitch;
+	const uint32_t *offset = desc->layers[0].offset;
+	uint64_t end = 0;
+
+	if (desc->objects[0].fd < 0 || pitch[0] < width)
+		return VA_STATUS_ERROR_INVALID_PARAMETER;
+	if (offset[0] || offset[1] % pitch[0] ||
+	    (planes == 3 && offset[2] % pitch[0]) ||
+	    pitch[1] != (planes == 2 ? pitch[0] : pitch[0] / 2) ||
+	    (planes == 3 && pitch[2] != pitch[1]))
+		return VA_STATUS_ERROR_UNSUPPORTED_MEMORY_TYPE;
+
+	for (unsigned int i = 0; i < planes; i++) {
+		if (desc->layers[0].object_index[i] || offset[i] < end)
+			return VA_STATUS_ERROR_INVALID_PARAMETER;
+		end = offset[i] + (uint64_t)pitch[i] *
+		      (i == 0 ? height : height / 2);
+	}
+	if (end > desc->objects[0].size)
+		return VA_STATUS_ERROR_INVALID_PARAMETER;
+
+	*fd = desc->objects[0].fd;
+	*external = (VASurfaceAttribExternalBuffers) {
+		.pixel_format = desc->fourcc,
+		.width = width,
+		.height = height,
+		.data_size = desc->objects[0].size,
+		.num_planes = planes,
+		.buffers = fd,
+		.num_buffers = 1,
+	};
+	for (unsigned int i = 0; i < planes; i++) {
+		external->pitches[i] = pitch[i];
+		external->offsets[i] = offset[i];
+	}
+	return VA_STATUS_SUCCESS;
+}
