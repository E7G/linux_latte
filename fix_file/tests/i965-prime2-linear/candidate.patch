-			memory_attribute = (VASurfaceAttribExternalBuffers *)attrib_list[i].value.value.p;
+			descriptor = attrib_list[i].value.value.p;
 		}
 	}

+	VASurfaceAttribExternalBuffers *memory_attribute = descriptor;
+	if (prime2) {
+		if (num_surfaces != 1 || format != VA_RT_FORMAT_YUV420)
+			return VA_STATUS_ERROR_UNSUPPORTED_MEMORY_TYPE;
+		vaStatus = i965_prime2_to_external(descriptor, width, height,
+						 &prime2_external, &prime2_fd);
+		if (vaStatus != VA_STATUS_SUCCESS)
+			return vaStatus;
+		if (expected_fourcc && expected_fourcc != prime2_external.pixel_format)
+			return VA_STATUS_ERROR_INVALID_PARAMETER;
+		expected_fourcc = prime2_external.pixel_format;
+		memory_attribute = &prime2_external;
+	}
