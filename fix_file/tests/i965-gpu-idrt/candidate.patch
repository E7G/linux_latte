diff --git a/src/mp2_i965_diag.c b/src/mp2_i965_diag.c
--- /dev/null
+++ b/src/mp2_i965_diag.c
@@ -0,0 +1,138 @@
+/* SPDX-License-Identifier: MIT */
+/* Private aggregates only. Optional, PID-scoped; never reads frame payloads.
+ * Mapped tmpfs aggregates survive VA driver unload/reload; no per-frame I/O. */
+#define _GNU_SOURCE
+#include "mp2_i965_diag.h"
+#include <stdatomic.h>
+#include <sys/mman.h>
+#include <sys/stat.h>
+#include <fcntl.h>
+#include <time.h>
+#include <unistd.h>
+#include <stdlib.h>
+#include <string.h>
+#include <errno.h>
+struct mp2_stats {
+ _Atomic uint64_t calls, nonzero_results, wall_total, wall_max;
+ _Atomic uint64_t cpu_total, cpu_max, over33, over50;
+};
+struct mp2_data {
+ char magic[8]; uint32_t version, phases;
+ uint64_t pid, start_ns;
+ _Atomic uint64_t loads, active_loads;
+ uint64_t early_enabled;
+ _Atomic uint64_t early_preparations;
+ struct mp2_stats phase[MP2_PHASES];
+ _Atomic uint64_t iteration_histogram[16];
+ uint64_t gpu_enabled;
+ _Atomic uint64_t gpu_preparations, gpu_command_uploads, gpu_fallbacks;
+};
+_Static_assert(sizeof(struct mp2_stats)==64,"stats ABI");
+_Static_assert(sizeof(struct mp2_data)==1888,"file ABI");
+static struct mp2_data *data;
+static uint64_t clock_ns(clockid_t id) {
+ struct timespec t;
+ if (clock_gettime(id,&t)) return 0;
+ return (uint64_t)t.tv_sec*1000000000ULL+(uint64_t)t.tv_nsec;
+}
+static void max_value(_Atomic uint64_t *p,uint64_t value) {
+ uint64_t old=atomic_load_explicit(p,memory_order_relaxed);
+ while (old<value && !atomic_compare_exchange_weak_explicit(p,&old,value,
+          memory_order_relaxed,memory_order_relaxed)) {}
+}
+struct mp2_stamp mp2_diag_start(void) {
+ int saved=errno;struct mp2_stamp r={0,0};
+ if (data && data->pid==(uint64_t)getpid()) {
+  r.wall=clock_ns(CLOCK_MONOTONIC);r.cpu=clock_ns(CLOCK_THREAD_CPUTIME_ID);
+ }
+ errno=saved;return r;
+}
+void mp2_diag_end(enum mp2_phase id,struct mp2_stamp begin,int result) {
+ int saved=errno;
+ if (!data || !begin.wall || !begin.cpu || id>=MP2_PHASES) {errno=saved;return;}
+ uint64_t cpu=clock_ns(CLOCK_THREAD_CPUTIME_ID),wall=clock_ns(CLOCK_MONOTONIC);
+ if (cpu<begin.cpu || wall<begin.wall) {errno=saved;return;}
+ cpu-=begin.cpu;wall-=begin.wall;
+ struct mp2_stats *s=&data->phase[id];
+ atomic_fetch_add_explicit(&s->calls,1,memory_order_relaxed);
+ atomic_fetch_add_explicit(&s->nonzero_results,result!=0,memory_order_relaxed);
+ atomic_fetch_add_explicit(&s->wall_total,wall,memory_order_relaxed);
+ atomic_fetch_add_explicit(&s->cpu_total,cpu,memory_order_relaxed);
+ atomic_fetch_add_explicit(&s->over33,wall>33333333,memory_order_relaxed);
+ atomic_fetch_add_explicit(&s->over50,wall>50000000,memory_order_relaxed);
+ max_value(&s->wall_max,wall);max_value(&s->cpu_max,cpu);
+ errno=saved;
+}
+void mp2_diag_frame_iterations(unsigned n) {
+ if (data && data->pid==(uint64_t)getpid())
+  atomic_fetch_add_explicit(&data->iteration_histogram[n<15?n:15],1,memory_order_relaxed);
+}
+__attribute__((constructor)) static void mp2_diag_initialize(void) {
+ int saved=errno;
+ const char *p=getenv("MP2_I965_DIAG_FILE"),*pid=getenv("MP2_I965_DIAG_PID");
+ const char *gf=getenv("MP2_I965_GPU_MBENC_IDRT"),*ef=getenv("MP2_I965_EARLY_MBENC_IDRT");
+ uint64_t gpu_enabled=gf && !strcmp(gf,"1");
+ if (gpu_enabled && ef && !strcmp(ef,"1")) goto finish;
+ if (!p || p[0]!='/' || !pid || strtoull(pid,NULL,10)!=(uint64_t)getpid()) goto finish;
+ int created=1,fd=open(p,O_RDWR|O_CREAT|O_EXCL|O_CLOEXEC|O_NOFOLLOW,0600);
+ if (fd<0 && errno==EEXIST) {created=0;fd=open(p,O_RDWR|O_CLOEXEC|O_NOFOLLOW);}
+ if (fd<0) goto finish;
+ struct stat st;
+ if (fstat(fd,&st) || !S_ISREG(st.st_mode) || st.st_uid!=geteuid() || st.st_nlink!=1 || (st.st_mode&077)) {close(fd);goto finish;}
+ if (created && ftruncate(fd,sizeof(struct mp2_data))) {close(fd);goto finish;}
+ if (!created && st.st_size!=sizeof(struct mp2_data)) {close(fd);goto finish;}
+ void *map=mmap(NULL,sizeof(struct mp2_data),PROT_READ|PROT_WRITE,MAP_SHARED,fd,0);close(fd);
+ if (map==MAP_FAILED) goto finish;
+ struct mp2_data *d=map;
+ const char *flag=getenv("MP2_I965_EARLY_MBENC_IDRT");
+ uint64_t enabled=flag && !strcmp(flag,"1");
+ if (created) {
+  memset(d,0,sizeof(*d));d->version=6;d->phases=MP2_PHASES;d->pid=(uint64_t)getpid();d->start_ns=clock_ns(CLOCK_MONOTONIC);
+  atomic_init(&d->loads,0);atomic_init(&d->active_loads,0);
+  d->early_enabled=enabled;atomic_init(&d->early_preparations,0);
+  d->gpu_enabled=gpu_enabled;atomic_init(&d->gpu_preparations,0);atomic_init(&d->gpu_command_uploads,0);atomic_init(&d->gpu_fallbacks,0);
+  for (unsigned i=0;i<MP2_PHASES;i++) {
+#define INIT(F) atomic_init(&d->phase[i].F,0)
+   INIT(calls);INIT(nonzero_results);INIT(wall_total);INIT(wall_max);INIT(cpu_total);INIT(cpu_max);INIT(over33);INIT(over50);
+#undef INIT
+  }
+  for (unsigned i=0;i<16;i++) atomic_init(&d->iteration_histogram[i],0);
+  memcpy(d->magic,"MP2I9656",8);
+ }
+ if (memcmp(d->magic,"MP2I9656",8) || d->version!=6 || d->phases!=MP2_PHASES || d->pid!=(uint64_t)getpid() || d->early_enabled!=enabled || d->gpu_enabled!=gpu_enabled || !atomic_is_lock_free(&d->loads)) {munmap(d,sizeof(*d));goto finish;}
+ data=d;atomic_fetch_add_explicit(&d->loads,1,memory_order_relaxed);atomic_fetch_add_explicit(&d->active_loads,1,memory_order_relaxed);
+finish:
+ errno=saved;
+}
+__attribute__((destructor)) static void mp2_diag_finish(void) {
+ int saved=errno;
+ if (data) {atomic_fetch_sub_explicit(&data->active_loads,1,memory_order_relaxed);munmap(data,sizeof(*data));data=NULL;}
+ errno=saved;
+}
+
+int mp2_diag_early_idrt_enabled(void) {
+ int saved=errno;
+ int enabled=data && data->pid==(uint64_t)getpid() && data->early_enabled==1;
+ errno=saved;return enabled;
+}
+void mp2_diag_record_early_idrt(void) {
+ int saved=errno;
+ if (mp2_diag_early_idrt_enabled())
+  atomic_fetch_add_explicit(&data->early_preparations,1,memory_order_relaxed);
+ errno=saved;
+}
+
+int mp2_diag_gpu_idrt_enabled(void) {
+ int saved=errno;
+ int enabled=data && data->pid==(uint64_t)getpid() && data->gpu_enabled==1 && !data->early_enabled;
+ errno=saved;return enabled;
+}
+void mp2_diag_gpu_idrt_event(unsigned event) {
+ int saved=errno;
+ if (mp2_diag_gpu_idrt_enabled()) {
+  if (event==0) atomic_fetch_add_explicit(&data->gpu_preparations,1,memory_order_relaxed);
+  else if (event==1) atomic_fetch_add_explicit(&data->gpu_command_uploads,1,memory_order_relaxed);
+  else if (event==2) atomic_fetch_add_explicit(&data->gpu_fallbacks,1,memory_order_relaxed);
+ }
+ errno=saved;
+}
diff --git a/src/mp2_i965_diag.h b/src/mp2_i965_diag.h
--- /dev/null
+++ b/src/mp2_i965_diag.h
@@ -0,0 +1,22 @@
+/* SPDX-License-Identifier: MIT */
+#ifndef MP2_I965_DIAG_H
+#define MP2_I965_DIAG_H
+#include <stdint.h>
+enum mp2_phase {
+ MP2_ENCODER, MP2_SANITY, MP2_BRC_PREPARE, MP2_VME, MP2_MFC,
+ MP2_VME_UPDATE_CHECK, MP2_VME_ALLOCATE, MP2_VME_PREPARE, MP2_VME_INIT,
+ MP2_VME_RUN, MP2_VME_FINAL,
+ MP2_RUN_BRC_INIT, MP2_RUN_SCALING, MP2_RUN_HME, MP2_RUN_SFD,
+ MP2_RUN_BRC_UPDATE, MP2_RUN_WP, MP2_RUN_MBENC,
+ MP2_MB_CONTEXT_RESET, MP2_MB_CURBE, MP2_MB_CONST_DATA, MP2_MB_MAD_CLEAR,
+ MP2_MB_SURFACES, MP2_MB_IDRT, MP2_MB_WALKER_PREPARE, MP2_MB_SUBMIT, MP2_PHASES
+};
+struct mp2_stamp { uint64_t wall, cpu; };
+struct mp2_stamp mp2_diag_start(void);
+void mp2_diag_end(enum mp2_phase, struct mp2_stamp, int);
+void mp2_diag_frame_iterations(unsigned);
+int mp2_diag_early_idrt_enabled(void);
+void mp2_diag_record_early_idrt(void);
+int mp2_diag_gpu_idrt_enabled(void);
+void mp2_diag_gpu_idrt_event(unsigned event);
+#endif
