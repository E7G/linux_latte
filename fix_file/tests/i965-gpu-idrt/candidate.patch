diff --git a/src/i965_gpe_utils.c b/src/i965_gpe_utils.c
--- a/src/i965_gpe_utils.c
+++ b/src/i965_gpe_utils.c
@@ -1716,0 +1717,68 @@
+}
+
+/* SPDX-License-Identifier: MIT */
+/* Private CHV experiment: do not map a BRC-owned dynamic-state BO on the CPU.
+ * PIPE_CONTROL post-sync writes with CS_STALL, not unsynchronized MI stores.
+ * Eligibility is deliberately narrower than the ordinary CPU implementation. */
+int
+mp2_gen8_gpu_idrt_eligible(const struct i965_gpe_context *g)
+{
+    if (!g || !g->idrt.bo || g->num_kernels != 1 ||
+        g->idrt.max_entries != 1 || g->idrt.entry_size != 64 ||
+        g->dynamic_state.bo != g->idrt.bo || g->curbe.bo != g->idrt.bo ||
+        g->dynamic_state.bo_size <= 0 || !g->curbe.length ||
+        g->sampler.max_entries || g->sampler.entry_size ||
+        (g->idrt.offset & 63) || (g->kernels[0].kernel_offset & 63))
+        return 0;
+    const uint64_t end = (uint64_t)g->idrt.offset + g->idrt.entry_size;
+    return (uint64_t)g->curbe.offset + g->curbe.length <= g->idrt.offset &&
+        end <= (uint64_t)g->dynamic_state.bo_size &&
+        (uint64_t)g->dynamic_state.bo_size <= g->idrt.bo->size;
+}
+
+int
+mp2_gen8_gpu_idrt_upload(VADriverContextP ctx,
+                         struct i965_gpe_context *g,
+                         struct intel_batchbuffer *batch)
+{
+    struct gen8_interface_descriptor_data desc;
+    struct gpe_pipe_control_parameter p;
+    uint32_t words[8];
+    unsigned i;
+
+    if (!batch || !mp2_gen8_gpu_idrt_eligible(g))
+        return 0;
+
+    /* Match gen8_gpe_setup_interface_data byte-for-byte, including zero bits. */
+    memset(&desc, 0, sizeof(desc));
+    desc.desc0.kernel_start_pointer = g->kernels[0].kernel_offset >> 6;
+    desc.desc3.sampler_count = 0;
+    desc.desc3.sampler_state_pointer = g->sampler.offset >> 5;
+    desc.desc4.binding_table_entry_count = 0;
+    desc.desc4.binding_table_pointer =
+        g->surface_state_binding_table.binding_table_offset >> 5;
+    desc.desc5.constant_urb_entry_read_offset = 0;
+    desc.desc5.constant_urb_entry_read_length = ALIGN(g->curbe.length, 32) >> 5;
+    _Static_assert(sizeof(desc) == sizeof(words), "Gen8 IDRT is 32 bytes");
+    memcpy(words, &desc, sizeof(words));
+
+    /* Vol7 p19: CS_STALL + flushed write caches + immediate post-sync write.
+     * Each command retains a writable relocation to the same dynamic-state BO.
+     * Earlier BRC batches remain dependencies; the caller retains its existing
+     * preamble flush and atomic batch reservation before entering this helper. */
+    memset(&p, 0, sizeof(p));
+    p.bo = g->idrt.bo;
+    p.flush_mode = PIPE_CONTROL_FLUSH_WRITE_CACHE;
+    for (i = 0; i < 4; i++) {
+        p.offset = g->idrt.offset + 8 * i;
+        p.dw0 = words[2 * i];
+        p.dw1 = words[2 * i + 1];
+        gen8_gpe_pipe_control(ctx, batch, &p);
+    }
+
+    /* Last post-sync completion precedes this top-of-pipe invalidation, and
+     * both precede STATE_BASE_ADDRESS / CURBE_LOAD / INTERFACE_LOAD. */
+    memset(&p, 0, sizeof(p));
+    p.flush_mode = PIPE_CONTROL_FLUSH_READ_CACHE;
+    gen8_gpe_pipe_control(ctx, batch, &p);
+    return 1;
@@ -2501 +2569 @@
-	int cs_stall_enable = !param->disable_cs_stall;
+	int cs_stall_enable = param->disable_cs_stall ? 0 : CMD_PIPE_CONTROL_CS_STALL;
