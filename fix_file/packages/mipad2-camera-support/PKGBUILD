pkgname=mipad2-camera-support
pkgver=20260901
pkgrel=3
pkgdesc="Mi Pad 2 AtomISP camera support and firmware"
arch=(x86_64)
license=(GPL2)
package() {
  install -Dm644 "$srcdir/mipad2-camera.conf" \
    "$pkgdir/etc/modules-load.d/mipad2-camera.conf"
  install -Dm644 "$srcdir/README" \
    "$pkgdir/usr/share/doc/mipad2-camera-support/README"
  install -Dm644 "$srcdir/intel/ipu/shisp_2401a0_v21.bin" \
    "$pkgdir/usr/lib/firmware/intel/ipu/shisp_2401a0_v21.bin"
}
