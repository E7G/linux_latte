pkgname=mipad2-usb-serial
pkgver=20260925
pkgrel=5
pkgdesc="Persistent Mi Pad 2 USB ACM serial console"
arch=(x86_64)
license=(GPL2)
depends=(systemd util-linux)
conflicts=(mipad2-usb-gadget)
replaces=(mipad2-usb-gadget)

source=(
  'README'
  'mipad2-usb-serial'
  'mipad2-usb-serial-sleep'
  'mipad2-usb-serial.service'
  'mipad2-usb-serial-quiesce.service'
  'mipad2-usb-serial-quiesce'
  '60-shutdown-quiesce.conf'
)
sha256sums=(
  '12e03c9014027f612c6ad1947759f4f2b469418ef100ebd7e9031ef28a872953'
  'df2e9e916b7142a22139f7479d35c27327a3b9b4c44ed23a9f218755c38d93bc'
  'd44ce8ae5de751e925e88db6bbbbcd340c4e1403b39a5f36356ac277894a18cd'
  '1e5ee26a5c8de392b0058460203f34ea382625a7d52a05c08236309b958f1bb1'
  '3d595109ffe24bfb4e75a08809bff0a360b320e0d7c54b9a3d5dcf0b1fd682f7'
  '47c19092dd2a41015197cb29854596b1ed3e42f4c4b67f107ef958cb4fe0bbba'
  'c7f86c0904e7153ffb7951d6017e276644f85245eb9048512964be0e67410f86'
)

package() {
  install -Dm755 "$srcdir/mipad2-usb-serial" \
    "$pkgdir/usr/local/libexec/mipad2-usb-serial"
  install -Dm644 "$srcdir/mipad2-usb-serial.service" \
    "$pkgdir/etc/systemd/system/mipad2-usb-serial.service"
  install -Dm644 "$srcdir/mipad2-usb-serial-quiesce.service" \
    "$pkgdir/usr/lib/systemd/system/mipad2-usb-serial-quiesce.service"
  install -Dm755 "$srcdir/mipad2-usb-serial-quiesce" \
    "$pkgdir/usr/local/libexec/mipad2-usb-serial-quiesce"
  install -Dm644 "$srcdir/60-shutdown-quiesce.conf" \
    "$pkgdir/usr/lib/systemd/system/mipad2-usb-serial.service.d/60-shutdown-quiesce.conf"
  install -Dm755 "$srcdir/mipad2-usb-serial-sleep" \
    "$pkgdir/usr/lib/systemd/system-sleep/mipad2-usb-serial"
  install -Dm644 "$srcdir/README" \
    "$pkgdir/usr/share/doc/mipad2-usb-serial/README"
}
