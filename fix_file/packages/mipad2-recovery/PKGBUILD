pkgname=mipad2-recovery
pkgver=20260925
pkgrel=1
pkgdesc="Timeshift/BTRFS backup and one-command recovery tools for Mi Pad 2"
arch=(x86_64)
license=(GPL2)
depends=(btrfs-progs timeshift util-linux zstd)

package() {
  install -Dm755 "$srcdir/mp2-backup" "$pkgdir/usr/local/sbin/mp2-backup"
  install -Dm755 "$srcdir/mp2-recover" "$pkgdir/usr/local/sbin/mp2-recover"
  install -Dm644 "$srcdir/README" \
    "$pkgdir/usr/share/doc/mipad2-recovery/README"
}
